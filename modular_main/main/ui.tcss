Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}

#agent-response-modal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.agent-response-dialog {
    width: 80%;
    height: 80%;
    max-width: 120;
    max-height: 40;
}

#agent-response-title {
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#agent-response-content {
    width: 1fr;
    height: 1fr;
}

#agent-response-close {
    width: 12;
    margin: 1 0 0 0;
    dock: right;
}

Label,
Static,
ListView,
ListItem,
Input,
Select {
    color: $foreground;
}

ListView,
Input,
Select {
    background: $background;
}

ListItem.-highlight {
    color: $background;
}

#stage {
    height: auto;
    border: round $primary;
    background: $surface;
    color: $foreground;
    padding: 0 2;
}

#stage-label {
      width: 1fr;
      height: auto;
      text-wrap: wrap;
  }

#settings-label {
    width: 1fr; 
    height: auto; 
    color: #ffb8e4 
}

#main-content {
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 3fr;
    grid-gutter: 1;
    background: $background;
}

.panel {
    border: round $primary 60%;
    background: $surface;
    color: $foreground;
    border-title-color: $foreground;
    border-title-background: $surface;
    border-title-style: bold;
    padding: 1;
}

.panel:focus-within {
    border: round $primary 60%;
}

#right-content {
    layout: grid;
    grid-size: 1 2;
    grid-rows: 3fr 1fr;
    grid-gutter: 1;
}

#right-content.right-bottom-focused {
    grid-rows: 1fr 3fr;
}

#right-content.right-top-focused {
    grid-rows: 3fr 1fr;
}

#left-content {
    height: 1fr;
    layout: vertical;
}

#files-panel {
    height: 3fr;
}

#deps-graph-preview-panel {
    height: 2fr;
    overflow: auto;
}

#deps-graph-panel,
#requirements-panel {
    height: 1fr;
}

#deps-graph-image {
    width: auto;
    height: auto;
}

#deps-graph-controls {
    height: 3;
    align: right middle;
}

#deps-graph-controls Button {
    min-width: 5;
    margin-left: 1;
}

#file-list {
    height: 1fr;
    margin-top: 1;
    background: $background;
}

#selected-file-content {
    height: 1fr;
    background: $surface;
    color: $foreground;
    border: none;
    padding: 0;
}

#suggestions {
    height: 1fr;
    overflow: auto;
    background: $surface;
}

.suggestion-header,
.suggestion-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: 2fr 2fr 4fr 3fr;
    align: left middle;
    height: auto;
    padding: 0 1;
}

.suggestion-header {
    color: $secondary;
    text-style: bold;
    background: $panel;
    height: 1;
}

.suggestion-header > Label {
    height: 1;
    content-align: left middle;
}

.suggestion-row {
    color: $foreground;
    border-top: solid $panel;
}

.suggestion-row > Label {
    height: auto;
    content-align: left middle;
}

.suggestion-row > Select {
    width: 1fr;
    height: auto;
    margin: 0;
}

.suggestion-row SelectCurrent {
    border: none; 
}


.suggestion-row > Input {
    width: 1fr;
    height: 3;
    margin: 0;
}

/* Flip the menu above the control when there isn't enough room below it. */
.suggestion-row SelectOverlay {
    constrain: none inflect;
}

.suggestion-row TextArea {
    width: 1fr;
    max-width: 100%;
    height: 100%;
    min-height: 3;
    border: solid $panel;
}

.suggestion-row Input:focus {
    border: tall $primary;
}

.human-text{
    color: #ffdc42
}

#analyzer-submit-button {
    width: 1fr;
    height: 5;
    align: right bottom;
}

#analyzer-additional-feedback {
    width: 1fr;
    height: 5;
    min-height: 3;
    border: solid $panel;
}

#analyzer-submit-button #analyzer-submit {
    margin-left: 1;
    margin-top: 1;
}

#human-response-view {
    display: none;
    height: auto;
    margin-top: 1;
    overflow-y: auto;
}

#human-question {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
}

#human-response {
    width: 1fr;
    height: 1fr;
    min-height: 5;
    border: round $primary 60%;
    background: $surface;
}

#human-submit-button {
    height: 3;
    align: right middle;
}

Button {
    background: $panel;
    color: $foreground;
    border: tall $panel;
}

Button:hover {
    background: $secondary;
    color: $background;
}

Button:focus {
    border: tall $primary;
}

Button.-primary {
    background: $primary;
    color: $background;
}

Button.-success {
    background: $success;
    color: white;
    text-style: bold;
}

#submit {
    background: $success;
    color: white;
    text-style: bold;
}

#submit:hover {
    background: $secondary;
    color: white;
}

Button.-warning {
    background: $warning;
    color: $background;
}

Button.-error {
    background: $error;
    color: $foreground;
}
